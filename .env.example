# =============================================================================
# BookingBlues — environment variables (see CLAUDE.md §7)
# Copy to .env.local for development. Never commit real values.
# =============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# --- App URLs --------------------------------------------------------------
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# --- Web (NEXT_PUBLIC_* are bundled into the browser; mirror the URLs) -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Mirror booking-fee economics so the wizard can prefill + render the math
NEXT_PUBLIC_PLATFORM_TAKE_RATE_BPS=1000
NEXT_PUBLIC_DEFAULT_BOOKING_FEE_CENTS=2500
# Mirror of api ENABLED_CATEGORIES so the wizard renders matching options.
# Comma-separated trade slugs. Unset = all 5 seeded trades exposed
# (plumbing, hvac, electrical, roofing, garage_door). Set explicitly if a
# go-live needs to constrain the wizard to a subset.
NEXT_PUBLIC_ENABLED_CATEGORIES=
# "Schedule a setup call" banner URL surfaced on every onboarding step.
# Empty = banner hidden. Use a Calendly link in prod.
NEXT_PUBLIC_SETUP_CALL_BOOKING_URL=https://cal.com/malhotra-vikas/intro-session-30-minutes

# --- Supabase --------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Twilio ----------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_MESSAGING_SERVICE_SID=

# --- OpenAI ----------------------------------------------------------------
OPENAI_API_KEY=

# --- Stripe (platform) -----------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Six Stripe price IDs — one per (Solo|Crew|Fleet) × (monthly|annual).
# Create three products in Stripe Dashboard ("KeeprSteady — Solo|Crew|Fleet")
# and two recurring prices on each. Annual price is the 10× monthly rate
# (2 months free) — Solo $490/yr, Crew $6,500/yr, Fleet $14,990/yr.
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_SOLO_ANNUAL=
STRIPE_PRICE_CREW_MONTHLY=
STRIPE_PRICE_CREW_ANNUAL=
STRIPE_PRICE_FLEET_MONTHLY=
STRIPE_PRICE_FLEET_ANNUAL=
STRIPE_PUBLISHABLE_KEY=

# --- Stripe (booking-fee economics) ----------------------------------------
PLATFORM_TAKE_RATE_BPS=1000           # 10.00% (basis points) — our cut from each booking-fee charge
MIN_PLATFORM_FEE_CENTS=100            # $1.00 floor on our cut
DEFAULT_BOOKING_FEE_CENTS=2500        # $25.00 — prefill when an operator first enables fees
TRIAL_DAYS=7

# --- Google OAuth (Calendar) -----------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/v1/oauth/google/callback

# --- Email -----------------------------------------------------------------
RESEND_API_KEY=
# Quick-start (no domain setup): EMAIL_FROM="onboarding@resend.dev"
#   Resend's shared test sender. Works with any API key but can only deliver
#   to the email registered on your Resend account. Testing-only.
# Production: must be a verified Resend sender on a domain you control
#   (DKIM/SPF/DMARC verified in Resend dashboard).
EMAIL_FROM="onboarding@resend.dev"

# Shared secret for internal cron endpoints (daily summary etc.).
# Generate with: openssl rand -hex 32
CRON_SHARED_SECRET=

# --- Crypto (32-byte hex, AES-256-GCM key for refresh-token at-rest) -------
ENCRYPTION_KEY=

# --- Observability ---------------------------------------------------------
# Sentry is a no-op until these DSNs are set. SENTRY_DSN_API → api (server).
# SENTRY_DSN_WEB → web server/edge runtime. NEXT_PUBLIC_SENTRY_DSN_WEB → web
# browser bundle (a DSN is not a secret; it must be public to reach the client).
SENTRY_DSN_API=
SENTRY_DSN_WEB=
NEXT_PUBLIC_SENTRY_DSN_WEB=
# Optional: only needed to UPLOAD source maps during the web build (prod CI).
# Without them the Sentry build plugin no-ops; runtime error capture still works.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Telephony staging guards (CLAUDE.md §11.12) ---------------------------
# Comma-separated E.164 numbers allowed to receive outbound SMS in non-prod.
# Unset = block-all (fail-safe). Ignored in production.
OUTBOUND_SMS_ALLOWLIST=

# --- Slack — HITL (ADR 0010) -----------------------------------------------
# Single BookingBlues-team workspace install. Create the app in api.slack.com,
# install it once into the BB workspace, grab the bot token + the #hitl
# channel ID, and paste here. All operators' escalations post into this one
# channel; the SLACK_SIGNING_SECRET verifies inbound webhook HMACs.
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL_ID=        # #hitl — escalation alarms + buttons
SLACK_CONVOS_CHANNEL_ID= C0B369VJEAX        # #convos — per-conversation monitoring threads
SLACK_CHANNEL_LEADS_ID=          # #bb-leads — new-signup notifications
SLACK_SIGNING_SECRET=

# --- Plumbing-vertical MVP (PROGRESS.md Slice 16) -------------------------
# Comma-separated category slugs allowed at signup. Unset = all 5 seeded
# trades (legacy). For the plumbing-only MVP set:
#   ENABLED_CATEGORIES=plumbing
# Mirror NEXT_PUBLIC_ENABLED_CATEGORIES above for the wizard UI.
ENABLED_CATEGORIES=plumbing

# Public Calendly (or similar) URL surfaced as the "Schedule a setup call
# with our team" CTA on every onboarding step. Empty = button hidden.
SETUP_CALL_BOOKING_URL=
