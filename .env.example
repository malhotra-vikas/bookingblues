# =============================================================================
# BookingBlues — environment variables (see CLAUDE.md §7)
# Copy to .env.local for development. Never commit real values.
# =============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# --- App URLs --------------------------------------------------------------
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# --- Web (NEXT_PUBLIC_* are bundled into the browser; mirror the URLs) -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Mirror booking-fee economics so the wizard can prefill + render the math
NEXT_PUBLIC_PLATFORM_TAKE_RATE_BPS=1000
NEXT_PUBLIC_DEFAULT_BOOKING_FEE_CENTS=2500

# --- Supabase --------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Twilio ----------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_MESSAGING_SERVICE_SID=

# --- OpenAI ----------------------------------------------------------------
OPENAI_API_KEY=

# --- Stripe (platform) -----------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PUBLISHABLE_KEY=

# --- Stripe (booking-fee economics) ----------------------------------------
PLATFORM_TAKE_RATE_BPS=1000           # 10.00% (basis points) — our cut from each booking-fee charge
MIN_PLATFORM_FEE_CENTS=100            # $1.00 floor on our cut
DEFAULT_BOOKING_FEE_CENTS=2500        # $25.00 — prefill when an operator first enables fees
TRIAL_DAYS=7

# --- Google OAuth (Calendar) -----------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/v1/oauth/google/callback

# --- Email -----------------------------------------------------------------
RESEND_API_KEY=

# --- Crypto (32-byte hex, AES-256-GCM key for refresh-token at-rest) -------
ENCRYPTION_KEY=

# --- Observability ---------------------------------------------------------
SENTRY_DSN_API=
SENTRY_DSN_WEB=

# --- Telephony staging guards (CLAUDE.md §11.12) ---------------------------
# Comma-separated E.164 numbers allowed to receive outbound SMS in non-prod.
# Unset = block-all (fail-safe). Ignored in production.
OUTBOUND_SMS_ALLOWLIST=

# --- Slack — HITL (ADR 0010) -----------------------------------------------
# Single BookingBlues-team workspace install. Create the app in api.slack.com,
# install it once into the BB workspace, grab the bot token + the #hitl
# channel ID, and paste here. All operators' escalations post into this one
# channel; the SLACK_SIGNING_SECRET verifies inbound webhook HMACs.
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL_ID=        # #hitl — escalation alarms + buttons
SLACK_CONVOS_CHANNEL_ID= C0B369VJEAX        # #convos — per-conversation monitoring threads
SLACK_SIGNING_SECRET=
