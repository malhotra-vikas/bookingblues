{
  "name": "bookingblues",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "gen:db": "supabase gen types typescript --local --schema public > packages/db-types/src/database.types.ts && prettier --write packages/db-types/src/database.types.ts",
    "db:migration:new": "supabase migration new",
    "db:reset": "supabase db reset",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@bookingblues/config": "workspace:*",
    "playwright": "^1.61.1",
    "prettier": "3.3.3",
    "turbo": "2.1.3",
    "typescript": "5.6.3"
  },
  "pnpm": {
    "overrides": {
      "express@4": "^4.22.3",
      "body-parser@1": "^1.20.9",
      "path-to-regexp@0.1": "^0.1.13",
      "proxy-addr@2": "^2.0.8",
      "axios@1": "^1.20.0",
      "follow-redirects": "^1.16.1",
      "form-data@4": "^4.0.6",
      "ws@8": "^8.21.0",
      "multer@2": "^2.5.0",
      "source-map-js@1": "^1.2.2"
    }
  }
}
